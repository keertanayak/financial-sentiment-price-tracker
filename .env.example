# ==============================================================================
# Financial Sentiment & Market Price Correlation Pipeline Configuration
# ==============================================================================

# News API Provider Keys (Optional — Pipeline falls back to yfinance / public RSS if empty)
# Get a free key at: https://newsapi.org/register (100 requests/day free)
NEWS_API_KEY=

# Alternative: GNews API Key
# Get a free key at: https://gnews.io/ (100 requests/day free)
GNEWS_API_KEY=

# Pipeline Defaults
DEFAULT_TICKERS=AAPL,MSFT,NVDA,RELIANCE.NS,TCS.NS
DEFAULT_DAYS_BACK=30

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
